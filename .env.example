# --- Ollama 本地模型 ---
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:latest
# 代码生成专用模型（ollama pull qwen2.5-coder:7b 拉取；未拉取时自动回退 CHAT_MODEL）
CODE_MODEL=qwen2.5-coder:7b
# 语义理解专用模型：需求质疑/澄清、spec 合并、报错裁判（ollama pull qwen2.5:14b 拉取；
# 未拉取时自动回退 CHAT_MODEL）
PLANNER_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text:latest

# --- 阿里云百炼 DashScope（可选，留空则全部走本地 Ollama）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# --- SiliconFlow 视频生成（可选，侧边栏"视频生成"功能用）---
SILICONFLOW_API_KEY=
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B

# --- 服务 ---
API_HOST=0.0.0.0
API_PORT=8000

# --- 数据目录 ---
DATA_DIR=./data
CHROMA_DIR=./data/chroma
# 远程 Chroma 服务地址（如 http://<内网Chroma地址>:8091）；留空则用本地 CHROMA_DIR
CHROMA_HTTP_URL=
